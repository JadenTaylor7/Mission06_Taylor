@{
	ViewData["Title"] = "EnterMovie";
}

@model Application

<div class="text-center">
    <h1 class="display-4">Add a Movie</h1>

    <form method="post">
        <div>
            <input type="hidden" asp-for="MovieId" />
        </div>
        <div>
            <select asp-for="CategoryId">
                <option value="">Select a Category</option>
                @foreach (Category c in ViewBag.Categories) 
                {
                    <option value="@c.CategoryId">@c.CategoryName</option>
                }
            </select>
        </div>

        <div>
            <label asp-for="Title">Title:</label>
            <input asp-for="Title" />
        </div>

        <div>
            <label asp-for="Year">Year:</label>
            <input asp-for="Year" />
        </div>

        <div>
            <label asp-for="Director">Director:</label>
            <input asp-for="Director" />
        </div>

        <div>
            <label asp-for="Rating">Rating:</label>
            <select asp-for="Rating">
                <option value="G">G</option>
                <option value="PG">PG</option>
                <option value="PG-13">PG-13</option>
                <option value="R">R</option>
            </select>
        </div>

        <div>
            <label asp-for="Edited">Edited:</label>
            <input type="radio" asp-for="Edited" value="true" /> Yes
            <input type="radio" asp-for="Edited" value="false" /> No
        </div>

        <div>
            <label asp-for="LentTo">Lent To:</label>
            <input asp-for="LentTo" />
        </div>

        <div>
            <label asp-for="CopiedToPlex">Copied to Plex:</label>
            <input type="radio" asp-for="CopiedToPlex" value="true" /> Yes
            <input type="radio" asp-for="CopiedToPlex" value="false" /> No
        </div>

        <div>
            <label asp-for="Notes">Notes:</label>
            <textarea asp-for="Notes"></textarea>
        </div>

        <button type="submit">Submit</button>

        <div asp-validation-summary="All"></div>
    </form>


</div>
