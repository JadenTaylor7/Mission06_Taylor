@{
}
@model Application
<h1>Are you sure you want to delete the Movie?</h1>

<h2>Movie to be deleted: @Model.Title</h2>

<form asp-controller="Home" asp-action="Delete" method="post">

    <input type="hidden" asp-for="MovieId" />

    <button type="submit">Yes</button>
    <a class="btn btn-outline-info" asp-controller="Home" asp-action="MovieCollection">No</a>

</form>