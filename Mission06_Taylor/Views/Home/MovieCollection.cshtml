@{
}
@model List<Application>
<h1>Welcome to the movie collection</h1>

<table class="table table-bordered">
    <thead>
      <tr>
          <th>Category</th>
          <th>Title</th>
          <th>Year</th>
          <th>Director</th>
          <th>Rating</th>
          <th>Edited</th>
          <th>Lent To</th>
          <th>Copied to Plex</th>
          <th>Notes</th>
      </tr>
    </thead>
    @foreach (var item in Model) {
    <tbody>
        <tr>
            <td>@item.CategoryName</td>
            <td>@item.Title</td>
            <td>@item.Year</td>
            <td>@item.Director</td>
            <td>@item.Rating</td>
            <td>@item.Edited</td>
            <td>@item.LentTo</td>
            <td>@item.CopiedToPlex</td>
            <td>@item.Notes</td>
            <td><a class="btn btn-primary" asp-controller="Home", asp-action="Edit" asp-route-id="@item.MovieId">Edit</a></td>
                <td><a class="btn btn-danger" asp-controller="Home" , asp-action="Delete" asp-route-id="@item.MovieId">Delete</a></td>
        </tr>
    </tbody>
    }

</table>

