@{
    ViewData["Title"] = "GetToKnow";
}


<div class="container mt-5">
    <div class="text-center">
        <h1 class="display-4">Get to Know Joel</h1>
        <h2 class="mt-4">Quick Links</h2>
        <div class="list-group">
            <a href="https://www.qwcomedy.com/" class="list-group-item list-group-item-action" target="_blank">Quick Wits Comedy</a>
            <a href="https://baconsale.com/" class="list-group-item list-group-item-action" target="_blank">Baconsale</a>
        </div>
        <div class="mt-4">
            <a href="https://baconsale.com/">
                <img src="~/img/baconsalekate.jpg" class="img-fluid rounded" alt="Baconsale Image" />
            </a>
        </div>
    </div>
</div>


